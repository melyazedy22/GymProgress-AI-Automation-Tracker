    {
      "parameters": {
        "jsCode": "const member = $input.first().json.body[0];\nconst login = $('Supabase Login').first().json.body;\n\nconst subscriptions = Array.isArray(member.subscriptions) ? member.subscriptions : [];\n\n// UTC dates, end date is exclusive\nconst today = new Date().toISOString().slice(0, 10);\n\nconst activeSubscription = subscriptions.find((s) =>\n  s.status === 'active' && s.start_date <= today && s.end_date > today\n) ?? null;\n\nconst requiredFields = ['age', 'height_cm', 'weight_kg', 'goal', 'experience_level'];\nconst missingFields = requiredFields.filter((f) =>\n  member[f] === null || member[f] === undefined || member[f] === ''\n);\n\nconst { subscriptions: _history, ...profile } = member;\n\nreturn [{\n  json: {\n    success: true,\n    message: 'Signed in successfully.',\n    session: {\n      access_token: login.access_token,\n      expires_at: login.expires_at ?? Math.floor(Date.now() / 1000) + (login.expires_in ?? 3600)\n    },\n    profile,\n    profile_complete: missingFields.length === 0,\n    missing_fields: missingFields,\n    membership: {\n      has_active_subscription: activeSubscription !== null,\n      subscription: activeSubscription\n    }\n  }\n}];"
      },
